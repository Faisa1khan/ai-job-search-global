# ==============================================================================
# AI Job Search & Application Pipeline Environment Configuration
# Copy this file to .env and fill in the values relevant to your setup.
# ==============================================================================

# Repository identity (used by test suites)
GITHUB_REPOSITORY=your_username/ai-job-search

# Portal Scraper API endpoints (optional overrides)
# FREEHIRE_API_URL=https://freehire.me
# HIMALAYAS_API_URL=https://himalayas.app/jobs/api
# REMOTIVE_API_URL=https://remotive.com/api/remote-jobs

# RapidAPI (optional, for external LinkedIn search proxies if used)
# RAPIDAPI_KEY=your_rapidapi_key_here

# Notion Sync (optional, for notion-sync skill)
# NOTION_API_KEY=secret_your_notion_api_key_here
# NOTION_DATABASE_ID=your_notion_database_id_here

# Headless Chromium Binary (optional override; default is google-chrome-stable)
# CHROME_PATH=google-chrome-stable
